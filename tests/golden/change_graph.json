      " \"\"\"Billing.\"\"\"",
      " from .store import Store",
      "+from .tax import vat",
      " ",
      " ",
      " class Invoice:",
      "     total: int = 0",
      " ",
      "     def add(self, amount):",
      "-        self.total += amount",
      "+        self.total += vat(amount)",
      "+        return self",
      "+",
      "+    def discount(self, pct):",
      "+        self.total -= self.total * pct",
      "         return self",
      " ",
      " ",
      "-def make_invoice(store: Store):",
      "-    inv = Invoice()",
      "+def make_invoice(store: Store, pct=0):",
      "+    inv = Invoice().discount(pct)",
      "     store.keep(inv)",
      "     return inv"
     ]
    }
